# MongoDB (required)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=movies

# ── LLM Provider ────────────────────────────────────────────
# Options: ollama, lmstudio, anthropic, openai
LLM_PROVIDER=ollama

# Ollama (default — local, free, no API key needed)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=Qwen3.8:latest

# LM Studio (local, OpenAI-compatible API)
# LLM_PROVIDER=lmstudio
# LMSTUDIO_URL=http://localhost:1234
# LMSTUDIO_MODEL=your-loaded-model

# Anthropic Claude (cloud — requires API key)
# LLM_PROVIDER=anthropic
# CLOUD_LLM_API_KEY=sk-ant-your-key
# CLOUD_LLM_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_API_URL=https://api.anthropic.com

# OpenAI GPT (cloud — requires API key)
# LLM_PROVIDER=openai
# CLOUD_LLM_API_KEY=sk-your-key
# CLOUD_LLM_MODEL=gpt-4o
# OPENAI_API_URL=https://api.openai.com

# ── Slack (optional) ────────────────────────────────────────
# SLACK_BOT_TOKEN=xoxb-your-token
# SLACK_SIGNING_SECRET=your-signing-secret

# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3000

# Auth (optional — protects /api/* routes when set)
# DASHBOARD_TOKEN=your-secret-token

# Safety
MAX_RESULT_ROWS=10000
ALLOWED_OPERATIONS=find,count,distinct,aggregate,insert,update

# Logging
RUST_LOG=info
